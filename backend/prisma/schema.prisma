generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TeacherStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum AttendanceSessionStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  REJECTED
}

enum AttendanceTokenType {
  QR
  TEXT_CODE
}

enum AttendanceAttemptOutcome {
  ACCEPTED
  INVALID_CODE
  EXPIRED_CODE
  SESSION_CLOSED
  OUTSIDE_RADIUS
  INACCURATE_LOCATION
  DUPLICATE
  INVALID_DETAILS
  RATE_LIMITED
  SUSPICIOUS
}

enum AuditActorType {
  ADMIN
  TEACHER
  SYSTEM
}

enum OtpPurpose {
  ADMIN_REGISTRATION
  ADMIN_PASSWORD_RESET
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum SymbolChallengeAttemptStatus {
  PENDING
  ACCEPTED
  LOCKED
}

model Admin {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String   @db.VarChar(120)
  email         String   @unique @db.VarChar(254)
  passwordHash  String   @db.VarChar(255)
  photoUrl      String?  @db.VarChar(2048)
  photoPublicId String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviewedTeachers Teacher[] @relation("TeacherReviewer")
}

model Teacher {
  id                   String        @id @default(uuid()) @db.Uuid
  teacherId            String        @unique @db.VarChar(30)
  fullName             String        @db.VarChar(120)
  email                String        @unique @db.VarChar(254)
  phone                String        @unique @db.VarChar(20)
  age                  Int
  gender               Gender
  highestQualification String        @db.VarChar(120)
  address              String        @db.VarChar(500)
  passwordHash         String        @db.VarChar(255)
  photoUrl             String?       @db.VarChar(2048)
  photoPublicId        String?       @db.VarChar(255)
  mustChangePassword   Boolean       @default(true)
  status               TeacherStatus @default(ACTIVE)
  rejectionReason      String?       @db.VarChar(1000)
  reviewedAt           DateTime?
  reviewedByAdminId    String?       @db.Uuid
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  reviewer           Admin?              @relation("TeacherReviewer", fields: [reviewedByAdminId], references: [id], onDelete: Restrict)
  attendanceSessions AttendanceSession[]
  correctedRecords   AttendanceRecord[]  @relation("AttendanceCorrection")

  @@index([fullName])
  @@index([phone])
  @@index([email])
  @@index([status, createdAt])
}

model AttendanceSession {
  id        String @id @default(uuid()) @db.Uuid
  teacherId String @db.Uuid

  // Session header
  courseName  String   @db.VarChar(150)
  subjectName String?  @db.VarChar(150)
  className   String?  @db.VarChar(100)
  roomName    String?  @db.VarChar(100)
  sections    String[]

  // Legacy teacher location fields retained for historical sessions
  latitude               Float?
  longitude              Float?
  locationAccuracyMeters Float?
  locationCapturedAt     DateTime?
  radiusMeters           Int?

  // Optional timetable fields; old sessions remain valid
  scheduledStartsAt      DateTime?
  scheduledEndsAt        DateTime?
  attendanceWindowEndsAt DateTime?

  // Actual session lifecycle
  status    AttendanceSessionStatus @default(ACTIVE)
  startsAt  DateTime                @default(now())
  endsAt    DateTime?
  closedAt  DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  records               AttendanceRecord[]
  qrTokens              QrCodeToken[]
  attempts              AttendanceAttempt[]
  challenges            AttendanceChallenge[]
  deviceLocks           AttendanceDeviceLock[]
  symbolChallenge       SymbolChallenge?
  symbolViolations      SymbolChallengeViolation[]
  symbolViolationEvents SymbolChallengeViolationEvent[]

  @@index([teacherId, status])
  @@index([teacherId, startsAt])
  @@index([createdAt])
}

model QrCodeToken {
  id                  String              @id @default(uuid()) @db.Uuid
  attendanceSessionId String              @db.Uuid
  tokenType           AttendanceTokenType @default(QR)
  tokenHash           String              @unique @db.VarChar(128)
  expiresAt           DateTime
  createdAt           DateTime            @default(now())

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  @@index([attendanceSessionId, expiresAt])
  @@index([attendanceSessionId, tokenType, expiresAt])
}

model AttendanceRecord {
  id                             String @id @default(uuid()) @db.Uuid
  attendanceSessionId            String @db.Uuid
  fullName                       String @db.VarChar(120)
  classRollNumber                String @db.VarChar(50)
  universityRollNumber           String @db.VarChar(80)
  normalizedUniversityRollNumber String @db.VarChar(80)
  section                        String @db.VarChar(50)

  // Location submitted by the student
  latitude               Float?
  longitude              Float?
  locationAccuracyMeters Float?
  distanceMeters         Float?

  status    AttendanceStatus @default(PRESENT)
  riskFlags String[]         @default([])

  // Teacher-authorised corrections
  correctionReason     String?   @db.VarChar(1000)
  correctedByTeacherId String?   @db.Uuid
  correctedAt          DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Restrict)
  correctedBy       Teacher?          @relation("AttendanceCorrection", fields: [correctedByTeacherId], references: [id], onDelete: Restrict)

  symbolChallengeAttempt SymbolChallengeAttempt?

  // One successful record per university roll number per session.
  // The same class roll number may exist in multiple sections.
  @@unique([attendanceSessionId, normalizedUniversityRollNumber])
  @@index([attendanceSessionId, status])
  @@index([attendanceSessionId, section, status])
  @@index([attendanceSessionId, submittedAt])
  @@index([universityRollNumber])
}

model AttendanceAttempt {
  id                             String  @id @default(uuid()) @db.Uuid
  attendanceSessionId            String  @db.Uuid
  normalizedUniversityRollNumber String? @db.VarChar(80)

  outcome                AttendanceAttemptOutcome
  riskFlags              String[]                 @default([])
  latitude               Float?
  longitude              Float?
  locationAccuracyMeters Float?
  distanceMeters         Float?

  // Do not store raw passwords, QR secrets or text codes here.
  metadata  Json?
  createdAt DateTime @default(now())

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  @@index([attendanceSessionId, createdAt])
  @@index([attendanceSessionId, normalizedUniversityRollNumber, createdAt])
  @@index([outcome, createdAt])
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorType  AuditActorType
  actorId    String?        @db.Uuid
  action     String         @db.VarChar(100)
  entityType String         @db.VarChar(100)
  entityId   String?        @db.Uuid
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([actorType, actorId, createdAt])
  @@index([entityType, entityId])
}

model OtpChallenge {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @db.VarChar(254)
  purpose             OtpPurpose
  codeHash            String     @db.VarChar(255)
  expiresAt           DateTime
  attempts            Int        @default(0)
  consumedAt          DateTime?
  pendingFullName     String?    @db.VarChar(120)
  pendingPasswordHash String?    @db.VarChar(255)
  resetTokenHash      String?    @unique @db.VarChar(255)
  resetTokenExpiresAt DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

// Persistent teacher login lockout: survives backend restarts.
model TeacherLoginLockout {
  email          String    @id @db.VarChar(254)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AttendanceChallenge {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceSessionId String    @db.Uuid
  tokenHash           String    @unique @db.VarChar(128)
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  @@index([attendanceSessionId, expiresAt])
  @@index([attendanceSessionId, consumedAt])
}

// Device lock for one specific attendance session.
// Only the hash of the device token is stored.
model AttendanceDeviceLock {
  id                  String   @id @default(uuid()) @db.Uuid
  attendanceSessionId String   @db.Uuid
  deviceTokenHash     String   @db.VarChar(64)
  createdAt           DateTime @default(now())

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, deviceTokenHash])
  @@index([attendanceSessionId])
}

// One Symbol Challenge per attendance session.
model SymbolChallenge {
  id                  String @id @default(uuid()) @db.Uuid
  attendanceSessionId String @unique @db.Uuid

  // Nine randomly generated symbols arranged in three rows.
  symbols Json

  // Three correct answers, one for each row.
  // Never return this field in student API responses.
  correctAnswers Json

  startedAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  attendanceSession AttendanceSession        @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  attempts          SymbolChallengeAttempt[]

  @@index([expiresAt])
}

// Tracks one device's Symbol Challenge verification for a session.
model SymbolChallengeAttempt {
  id                String @id @default(uuid()) @db.Uuid
  symbolChallengeId String @db.Uuid

  deviceTokenHash                String @db.VarChar(64)
  normalizedUniversityRollNumber String @db.VarChar(80)

  // Three wrong attempts result in a session-specific device lock.
  wrongAttempts Int @default(0)

  // Individual student's symbol challenge deadline; set when the grid is first issued.
  expiresAt DateTime?

  status SymbolChallengeAttemptStatus @default(PENDING)

  acceptedAt         DateTime?
  attendanceRecordId String?   @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symbolChallenge SymbolChallenge @relation(fields: [symbolChallengeId], references: [id], onDelete: Cascade)

  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)

  @@unique([symbolChallengeId, deviceTokenHash])
  @@index([symbolChallengeId, status])
  @@index([normalizedUniversityRollNumber])
}

// Persists fullscreen-exit and tab-switch violations per device and attendance session.
// The second violation is converted into an AttendanceDeviceLock by the API.
model SymbolChallengeViolation {
  id                             String    @id @default(uuid()) @db.Uuid
  attendanceSessionId            String    @db.Uuid
  deviceTokenHash                String    @db.VarChar(64)
  normalizedUniversityRollNumber String    @db.VarChar(80)
  violationCount                 Int       @default(0)
  lastViolationAt                DateTime  @default(now())
  lockedAt                       DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, deviceTokenHash])
  @@index([attendanceSessionId, lockedAt])
  @@index([normalizedUniversityRollNumber])
}

// Stores each distinct fullscreen/tab-switch incident exactly once.
// The unique constraint makes retries of the same incident idempotent.
model SymbolChallengeViolationEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  attendanceSessionId String   @db.Uuid
  deviceTokenHash     String   @db.VarChar(64)
  incidentId          String   @db.VarChar(80)
  createdAt           DateTime @default(now())

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, deviceTokenHash, incidentId])
  @@index([attendanceSessionId, deviceTokenHash, createdAt])
}

model GeofenceZone {
  id           String   @id @default(uuid()) @db.Uuid
  areaName     String   @db.VarChar(120)
  zoneName     String   @db.VarChar(120)
  latitude     Float
  longitude    Float
  radiusMeters Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([areaName])
}


model AdminLoginLockout {
  email          String    @id @db.VarChar(254)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastAttemptAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([lockedUntil])
}
